   Created At: 2026-08-22 | Last Modified: 2026-08-22
   Previous Version Back URL: (new file — no previous version)

   Task: BRIS-AI-T156

   ── Manual entry is the supported path ─────────────────────────
   A model name typed by hand must work with no code deployment. That
   is the requirement, and it is the fix for the failure this replaces:
   a hardcoded model list went stale, every AI call 404'd, and there was
   no way to enter a working name from inside the product.

   Discovery (GET /models via the gateway) fills a SUGGESTION list. It
   never gates the field — a provider that cannot list models, or lists
   an incomplete set, must not block a valid name.
   ============================================================ */
import { useState } from 'react';
import { AlertTriangle, Check, Cpu, Download, Loader2, Pencil, Plus, Trash2, X } from 'lucide-react';
import type { AiModel, ModelType } from '../../../services/platformAiConfigTypes';
import { canDeleteModel, validateModel } from '../../../services/platformAiConfigValidation';
import { deleteModel, setModelEnabled, upsertModel } from '../../../services/platformAiConfigService';
import { listProviderModels } from '../../../services/aiGatewayClient';
import type { AiConfigState } from './useAiConfig';

const MODEL_TYPES: Array<{ value: ModelType; label: string }> = [
  { value: 'chat', label: 'Chat / completion' },
  { value: 'stt', label: 'Speech to text' },
  { value: 'tts', label: 'Text to speech' },
  { value: 'embedding', label: 'Embedding' },
  { value: 'vision', label: 'Vision' },
  { value: 'other', label: 'Other' },
];

/** Guess the type from the model name, as a starting point only. */
function guessType(name: string): ModelType {
  const n = name.toLowerCase();
  if (/whisper|transcrib|speech-to-text|\bstt\b/.test(n)) return 'stt';
  if (/\btts\b|text-to-speech|speech-\d|voice/.test(n)) return 'tts';
  if (/embed/.test(n)) return 'embedding';
  if (/vision|\bvl\b|image/.test(n)) return 'vision';
  return 'chat';
}

function blankModel(providerId: string): AiModel {
  return {
    id: '', providerId, name: '', displayName: '',
    type: 'chat', enabled: true, contextWindow: null,
  };
}

export function ModelsTab({ state }: { state: AiConfigState }) {
  const { doc, run, setError } = state;

  const [editing, setEditing] = useState<AiModel | null>(null);
  const [isNew, setIsNew] = useState(false);
  const [saving, setSaving] = useState(false);

  const [discovering, setDiscovering] = useState('');
  const [discovered, setDiscovered] = useState<Record<string, string[]>>({});
  const [discoverError, setDiscoverError] = useState('');

  const startNew = () => {
    const firstProvider = doc.providers[0]?.id || '';
    setEditing(blankModel(firstProvider));
    setIsNew(true);
    setError('');
  };

  const startEdit = (m: AiModel) => { setEditing({ ...m }); setIsNew(false); setError(''); };
  const cancel = () => { setEditing(null); setIsNew(false); };

  const save = async () => {
    if (!editing) return;
    setError('');

    if (isNew && doc.models.some((m) => m.id.toLowerCase() === editing.id.trim().toLowerCase())) {
      setError(`A model with id "${editing.id}" already exists.`);
      return;
    }

    const issues = validateModel(editing, doc.providers).filter((i) => i.severity === 'error');
    if (issues.length) { setError(issues.map((i) => i.message).join(' ')); return; }

    setSaving(true);
    try {
      const ok = await run(() => upsertModel(editing), isNew ? 'Model added.' : 'Model saved.');
      if (ok) cancel();
    } finally {
      setSaving(false);
    }
  };

  const remove = async (m: AiModel) => {
    const check = canDeleteModel(doc, m.id);
    if (!check.allowed) {
      setError(`${check.message} Used by: ${check.blockedBy.join(', ')}.`);
      return;
    }
    if (!window.confirm(`Delete model "${m.displayName || m.name}"?`)) return;
    await run(() => deleteModel(m.id), 'Model deleted.');
  };

  const discover = async (providerId: string) => {
    setDiscovering(providerId);
    setDiscoverError('');
    try {
      const { models, error } = await listProviderModels(providerId);
      if (error) setDiscoverError(error);
      setDiscovered((prev) => ({ ...prev, [providerId]: models }));
    } finally {
      setDiscovering('');
    }
  };

  /** Take a discovered wire id straight into the form. */
  const useDiscovered = (providerId: string, wireName: string) => {
    setEditing({
      /* A sensible unique id derived from the name, still editable. */
      id: `${providerId}-${wireName}`.toLowerCase().replace(/[^a-z0-9._-]+/g, '-').slice(0, 64),
      providerId,
      name: wireName,
      displayName: wireName,
      type: guessType(wireName),
      enabled: true,
      contextWindow: null,
    });
    setIsNew(true);
    setError('');
  };

  const suggestions = editing ? (discovered[editing.providerId] || []) : [];

  return (
    <div className="aipc-tab">
      <div className="aipc-tab-head">
        <div>
          <h2 className="aipc-tab-title">Models</h2>
          <p className="aipc-tab-sub">
            Model ids belonging to a provider. Type any id by hand — a brand-new model name works
            immediately, with no code change.
          </p>
        </div>
        <button
          type="button"
          className="aipc-btn aipc-btn-primary"
          onClick={startNew}
          disabled={doc.providers.length === 0}
          title={doc.providers.length === 0 ? 'Add a provider first' : undefined}
        >
          <Plus size={15} /> Add model
        </button>
      </div>

      {doc.providers.length === 0 && (
        <div className="aipc-notice warn">
          <AlertTriangle size={15} />
          <span>Add a provider on the Providers tab first — every model belongs to one.</span>
        </div>
      )}

      {editing && (
        <div className="aipc-form">
          <div className="aipc-form-head">
            <h3>{isNew ? 'New model' : `Edit ${editing.displayName || editing.name}`}</h3>
            <button type="button" className="aipc-icon-btn" onClick={cancel} aria-label="Close"><X size={16} /></button>
          </div>

          <div className="aipc-grid">
            <label className="aipc-field">
              <span className="aipc-label">Provider</span>
              <select
                className="aipc-input"
                value={editing.providerId}
                onChange={(e) => setEditing({ ...editing, providerId: e.target.value })}
              >
                <option value="">Select a provider…</option>
                {doc.providers.map((p) => (
                  <option key={p.id} value={p.id}>{p.name}{p.enabled ? '' : ' (disabled)'}</option>
                ))}
              </select>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Model id (sent to the provider)</span>
              <input
                className="aipc-input"
                value={editing.name}
                placeholder="llama-3.1-8b-instant"
                onChange={(e) => {
                  const name = e.target.value;
                  setEditing((prev) => prev && ({
                    ...prev,
                    name,
                    /* Mirror into displayName and type only while the admin
                       has not overridden them, so typing the wire id fills
                       the form without ever fighting a manual edit. */
                    displayName: !prev.displayName || prev.displayName === prev.name ? name : prev.displayName,
                    type: !prev.displayName || prev.displayName === prev.name ? guessType(name) : prev.type,
                  }));
                }}
              />
              <span className="aipc-hint">
                Exactly as the provider expects it. Any value is accepted — this field is deliberately
                unvalidated beyond being non-empty.
              </span>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Internal id</span>
              <input
                className="aipc-input"
                value={editing.id}
                disabled={!isNew}
                placeholder="groq-llama-31-8b"
                onChange={(e) => setEditing({ ...editing, id: e.target.value })}
              />
              <span className="aipc-hint">
                {isNew ? 'How configurations reference this model.' : 'Cannot change — configurations reference it.'}
              </span>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Display name</span>
              <input
                className="aipc-input"
                value={editing.displayName}
                placeholder="Llama 3.1 8B Instant"
                onChange={(e) => setEditing({ ...editing, displayName: e.target.value })}
              />
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Type</span>
              <select
                className="aipc-input"
                value={editing.type}
                onChange={(e) => setEditing({ ...editing, type: e.target.value as ModelType })}
              >
                {MODEL_TYPES.map((t) => <option key={t.value} value={t.value}>{t.label}</option>)}
              </select>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Context window (optional)</span>
              <input
                className="aipc-input"
                type="number"
                value={editing.contextWindow ?? ''}
                placeholder="128000"
                onChange={(e) => setEditing({ ...editing, contextWindow: e.target.value === '' ? null : Number(e.target.value) })}
              />
              <span className="aipc-hint">Used to warn before a provider rejects an oversized request.</span>
            </label>

            <label className="aipc-field aipc-field-inline">
              <input type="checkbox" checked={editing.enabled} onChange={(e) => setEditing({ ...editing, enabled: e.target.checked })} />
              <span className="aipc-label">Enabled</span>
            </label>
          </div>

          {/* Discovery — a convenience beside the manual field, never in front of it. */}
          {editing.providerId && (
            <div className="aipc-discover">
              <div className="aipc-discover-head">
                <button
                  type="button"
                  className="aipc-btn aipc-btn-ghost"
                  onClick={() => discover(editing.providerId)}
                  disabled={discovering === editing.providerId}
                >
                  {discovering === editing.providerId ? <Loader2 size={14} className="aipc-spin" /> : <Download size={14} />}
                  Ask the provider which models it has
                </button>
                <span className="aipc-hint">Optional. Fills suggestions; the field above always accepts any value.</span>
              </div>
              {discoverError && <div className="aipc-notice warn"><AlertTriangle size={14} /><span>{discoverError}</span></div>}
              {suggestions.length > 0 && (
                <div className="aipc-suggestions">
                  {suggestions.map((s) => (
                    <button
                      key={s}
                      type="button"
                      className={`aipc-chip${editing.name === s ? ' on' : ''}`}
                      onClick={() => useDiscovered(editing.providerId, s)}
                    >
                      {s}
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}

          <div className="aipc-form-actions">
            <button type="button" className="aipc-btn" onClick={cancel} disabled={saving}>Cancel</button>
            <button type="button" className="aipc-btn aipc-btn-primary" onClick={save} disabled={saving}>
              {saving ? <Loader2 size={15} className="aipc-spin" /> : <Check size={15} />}
              {isNew ? 'Add model' : 'Save model'}
            </button>
          </div>
        </div>
      )}

      {doc.models.length === 0 ? (
        <div className="aipc-empty">
          <Cpu size={26} />
          <p>No models yet.</p>
          <p className="aipc-empty-sub">Add a model id, or ask a provider which models it offers.</p>
        </div>
      ) : (
        <div className="aipc-table-wrap">
          <table className="aipc-table">
            <thead>
              <tr>
                <th>Model</th>
                <th>Provider</th>
                <th>Sent as</th>
                <th>Type</th>
                <th>Context</th>
                <th>Status</th>
                <th className="aipc-col-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              {doc.models.map((m) => {
                const provider = doc.providers.find((p) => p.id === m.providerId);
                return (
                  <tr key={m.id} className={m.enabled ? '' : 'aipc-row-off'}>
                    <td>
                      <div className="aipc-cell-name">{m.displayName || m.name}</div>
                      <div className="aipc-cell-id">{m.id}</div>
                    </td>
                    <td>
                      {provider
                        ? <span className={provider.enabled ? '' : 'aipc-muted'}>{provider.name}</span>
                        : <span className="aipc-badge warn"><AlertTriangle size={11} /> Missing</span>}
                    </td>
                    <td><code className="aipc-code">{m.name}</code></td>
                    <td>{MODEL_TYPES.find((t) => t.value === m.type)?.label || m.type}</td>
                    <td>{m.contextWindow ? m.contextWindow.toLocaleString() : <span className="aipc-muted">—</span>}</td>
                    <td>
                      <button
                        type="button"
                        className={`aipc-toggle${m.enabled ? ' on' : ''}`}
                        onClick={() => run(() => setModelEnabled(m.id, !m.enabled), m.enabled ? 'Model disabled.' : 'Model enabled.')}
                        aria-label={m.enabled ? 'Disable model' : 'Enable model'}
                      >
                        <span />
                      </button>
                    </td>
                    <td className="aipc-col-actions">
                      <button type="button" className="aipc-icon-btn" title="Edit" onClick={() => startEdit(m)}><Pencil size={15} /></button>
                      <button type="button" className="aipc-icon-btn danger" title="Delete" onClick={() => remove(m)}><Trash2 size={15} /></button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}

export default ModelsTab;
