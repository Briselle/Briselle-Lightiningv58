   Briselle Enterprise Platform — Settings / AI Providers Config
   ConfigurationsTab.tsx — the abstraction modules consume
   Created At: 2026-08-22 | Last Modified: 2026-08-22
   Previous Version Back URL: (new file — no previous version)

   Task: BRIS-AI-T157

   An AI Configuration binds a provider + model + parameters under a
   stable id. A module asks for that id (or for a capability tag) and
   gets a call — it never learns which provider or model answered.

   That indirection is the whole point: swapping a model for the entire
   platform is an edit here, not a deployment.
   ============================================================ */
import { useState } from 'react';
import { AlertTriangle, Check, Copy, Layers, Loader2, Pencil, Plus, Trash2, X } from 'lucide-react';
import type { AiConfiguration } from '../../../services/platformAiConfigTypes';
import {
  canDeleteConfiguration,
  canExecuteConfiguration,
  validateConfiguration,
} from '../../../services/platformAiConfigValidation';
import {
  cloneConfiguration,
  deleteConfiguration,
  setConfigurationEnabled,
  upsertConfiguration,
} from '../../../services/platformAiConfigService';
import type { AiConfigState } from './useAiConfig';

function blankConfiguration(): AiConfiguration {
  return {
    id: '', name: '', description: '', providerId: '', modelId: '',
    parameters: {}, enabled: true, capabilities: [], priority: undefined,
  };
}

export function ConfigurationsTab({ state }: { state: AiConfigState }) {
  const { doc, run, setError } = state;

  const [editing, setEditing] = useState<AiConfiguration | null>(null);
  const [isNew, setIsNew] = useState(false);
  const [saving, setSaving] = useState(false);

  const startNew = () => { setEditing(blankConfiguration()); setIsNew(true); setError(''); };
  const startEdit = (c: AiConfiguration) => {
    setEditing({ ...c, parameters: { ...c.parameters }, capabilities: [...(c.capabilities || [])] });
    setIsNew(false);
    setError('');
  };
  const cancel = () => { setEditing(null); setIsNew(false); };

  const save = async () => {
    if (!editing) return;
    setError('');

    if (isNew && doc.configurations.some((c) => c.id.toLowerCase() === editing.id.trim().toLowerCase())) {
      setError(`A configuration with id "${editing.id}" already exists.`);
      return;
    }

    const issues = validateConfiguration(editing, doc.providers, doc.models).filter((i) => i.severity === 'error');
    if (issues.length) { setError(issues.map((i) => i.message).join(' ')); return; }

    setSaving(true);
    try {
      const ok = await run(() => upsertConfiguration(editing), isNew ? 'Configuration created.' : 'Configuration saved.');
      if (ok) cancel();
    } finally {
      setSaving(false);
    }
  };

  const remove = async (c: AiConfiguration) => {
    const check = canDeleteConfiguration(doc, c.id);
    /* Nothing inside this document can block it, but a module may name
       it — and this registry deliberately cannot know which. Say so
       plainly rather than deleting silently. */
    if (!window.confirm(`Delete configuration "${c.name}"?\n\n${check.message}`)) return;
    await run(() => deleteConfiguration(c.id), 'Configuration deleted.');
  };

  const clone = async (c: AiConfiguration) => {
    const newId = window.prompt(`New id for the copy of "${c.name}":`, `${c.id}-copy`);
    if (!newId) return;
    if (doc.configurations.some((x) => x.id.toLowerCase() === newId.trim().toLowerCase())) {
      setError(`A configuration with id "${newId}" already exists.`);
      return;
    }
    await run(() => cloneConfiguration(c.id, newId.trim(), `${c.name} (copy)`), 'Configuration cloned.');
  };

  const toggleCapability = (capId: string) => {
    setEditing((prev) => {
      if (!prev) return prev;
      const current = prev.capabilities || [];
      return {
        ...prev,
        capabilities: current.includes(capId) ? current.filter((x) => x !== capId) : [...current, capId],
      };
    });
  };

  /* Only models belonging to the selected provider. Offering the rest
     would let an admin build the provider/model mismatch that surfaces
     as a runtime 404 rather than a validation error. */
  const modelsForProvider = editing
    ? doc.models.filter((m) => m.providerId === editing.providerId)
    : [];

  const setParam = (key: 'temperature' | 'maxTokens' | 'topP', raw: string) => {
    setEditing((prev) => {
      if (!prev) return prev;
      const value = raw === '' ? undefined : Number(raw);
      return { ...prev, parameters: { ...prev.parameters, [key]: value } };
    });
  };

  return (
    <div className="aipc-tab">
      <div className="aipc-tab-head">
        <div>
          <h2 className="aipc-tab-title">AI Configurations</h2>
          <p className="aipc-tab-sub">
            A named provider + model + parameter set. This is what the rest of the platform calls, by id
            or by capability — swapping the model behind one is an edit here, not a release.
          </p>
        </div>
        <button
          type="button"
          className="aipc-btn aipc-btn-primary"
          onClick={startNew}
          disabled={doc.models.length === 0}
          title={doc.models.length === 0 ? 'Add a model first' : undefined}
        >
          <Plus size={15} /> Add configuration
        </button>
      </div>

      {doc.models.length === 0 && (
        <div className="aipc-notice warn">
          <AlertTriangle size={15} />
          <span>Add a provider and at least one model first — a configuration must reference both.</span>
        </div>
      )}

      {editing && (
        <div className="aipc-form">
          <div className="aipc-form-head">
            <h3>{isNew ? 'New configuration' : `Edit ${editing.name || editing.id}`}</h3>
            <button type="button" className="aipc-icon-btn" onClick={cancel} aria-label="Close"><X size={16} /></button>
          </div>

          <div className="aipc-grid">
            <label className="aipc-field">
              <span className="aipc-label">Configuration id</span>
              <input
                className="aipc-input"
                value={editing.id}
                disabled={!isNew}
                placeholder="fast-summary"
                onChange={(e) => setEditing({ ...editing, id: e.target.value })}
              />
              <span className="aipc-hint">
                {isNew
                  ? 'What a module passes to executeAI(). Choose it once and keep it stable.'
                  : 'Cannot change — modules reference this id.'}
              </span>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Name</span>
              <input
                className="aipc-input"
                value={editing.name}
                placeholder="Fast summary"
                onChange={(e) => setEditing({ ...editing, name: e.target.value })}
              />
            </label>

            <label className="aipc-field aipc-field-wide">
              <span className="aipc-label">Description</span>
              <input
                className="aipc-input"
                value={editing.description || ''}
                placeholder="Short, low-cost summarisation for long transcripts"
                onChange={(e) => setEditing({ ...editing, description: e.target.value })}
              />
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Provider</span>
              <select
                className="aipc-input"
                value={editing.providerId}
                onChange={(e) => {
                  const providerId = e.target.value;
                  /* Clear the model when the provider changes — keeping it
                     would leave a cross-provider pair that only fails at
                     call time. */
                  setEditing((prev) => prev && ({ ...prev, providerId, modelId: '' }));
                }}
              >
                <option value="">Select a provider…</option>
                {doc.providers.map((p) => (
                  <option key={p.id} value={p.id}>{p.name}{p.enabled ? '' : ' (disabled)'}</option>
                ))}
              </select>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Model</span>
              <select
                className="aipc-input"
                value={editing.modelId}
                disabled={!editing.providerId}
                onChange={(e) => setEditing({ ...editing, modelId: e.target.value })}
              >
                <option value="">{editing.providerId ? 'Select a model…' : 'Select a provider first'}</option>
                {modelsForProvider.map((m) => (
                  <option key={m.id} value={m.id}>{m.displayName || m.name}{m.enabled ? '' : ' (disabled)'}</option>
                ))}
              </select>
              {editing.providerId && modelsForProvider.length === 0 && (
                <span className="aipc-hint warn">This provider has no models yet. Add one on the Models tab.</span>
              )}
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Temperature</span>
              <input
                className="aipc-input"
                type="number" step="0.1" min="0" max="2"
                value={editing.parameters.temperature ?? ''}
                placeholder="0.3"
                onChange={(e) => setParam('temperature', e.target.value)}
              />
              <span className="aipc-hint">0–2. Blank leaves the provider default.</span>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Max tokens</span>
              <input
                className="aipc-input"
                type="number" min="1"
                value={editing.parameters.maxTokens ?? ''}
                placeholder="2048"
                onChange={(e) => setParam('maxTokens', e.target.value)}
              />
              <span className="aipc-hint">
                Caps the response. On some providers it also counts toward the per-minute token budget,
                so an oversized value can cause a 413 on a request that would otherwise pass.
              </span>
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Top P</span>
              <input
                className="aipc-input"
                type="number" step="0.05" min="0" max="1"
                value={editing.parameters.topP ?? ''}
                placeholder="1"
                onChange={(e) => setParam('topP', e.target.value)}
              />
            </label>

            <label className="aipc-field">
              <span className="aipc-label">Priority</span>
              <input
                className="aipc-input"
                type="number"
                value={editing.priority ?? ''}
                placeholder="1"
                onChange={(e) => setEditing({ ...editing, priority: e.target.value === '' ? undefined : Number(e.target.value) })}
              />
              <span className="aipc-hint">Lower wins when a caller asks by capability instead of by id.</span>
            </label>

            <label className="aipc-field aipc-field-inline">
              <input type="checkbox" checked={editing.enabled} onChange={(e) => setEditing({ ...editing, enabled: e.target.checked })} />
              <span className="aipc-label">Enabled</span>
            </label>

            <div className="aipc-field aipc-field-wide">
              <span className="aipc-label">Capabilities</span>
              <div className="aipc-chips">
                {doc.capabilities.map((cap) => {
                  const on = (editing.capabilities || []).includes(cap.id);
                  return (
                    <button
                      key={cap.id}
                      type="button"
                      className={`aipc-chip${on ? ' on' : ''}`}
                      title={cap.description}
                      onClick={() => toggleCapability(cap.id)}
                    >
                      {on && <Check size={12} />} {cap.label}
                    </button>
                  );
                })}
              </div>
              <span className="aipc-hint">
                A caller may pass a capability tag instead of this configuration's id. The
                highest-priority enabled configuration carrying the tag answers.
              </span>
            </div>
          </div>

          <div className="aipc-form-actions">
            <button type="button" className="aipc-btn" onClick={cancel} disabled={saving}>Cancel</button>
            <button type="button" className="aipc-btn aipc-btn-primary" onClick={save} disabled={saving}>
              {saving ? <Loader2 size={15} className="aipc-spin" /> : <Check size={15} />}
              {isNew ? 'Create configuration' : 'Save configuration'}
            </button>
          </div>
        </div>
      )}

      {doc.configurations.length === 0 ? (
        <div className="aipc-empty">
          <Layers size={26} />
          <p>No configurations yet.</p>
          <p className="aipc-empty-sub">
            Modules call AI by configuration id. Until one exists, every AI feature reports that it has
            no configuration to use.
          </p>
        </div>
      ) : (
        <div className="aipc-table-wrap">
          <table className="aipc-table">
            <thead>
              <tr>
                <th>Configuration</th>
                <th>Provider → Model</th>
                <th>Parameters</th>
                <th>Capabilities</th>
                <th>Ready</th>
                <th>Status</th>
                <th className="aipc-col-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              {doc.configurations.map((c) => {
                const provider = doc.providers.find((p) => p.id === c.providerId);
                const model = doc.models.find((m) => m.id === c.modelId);
                /* Same function the gateway uses, so the column and the
                   runtime can never disagree about whether this works. */
                const exec = canExecuteConfiguration(doc, c.id);
                const p = c.parameters || {};
                const paramText = [
                  p.temperature !== undefined ? `temp ${p.temperature}` : '',
                  p.maxTokens !== undefined ? `max ${p.maxTokens}` : '',
                  p.topP !== undefined ? `top_p ${p.topP}` : '',
                ].filter(Boolean).join(' · ');

                return (
                  <tr key={c.id} className={c.enabled ? '' : 'aipc-row-off'}>
                    <td>
                      <div className="aipc-cell-name">{c.name}</div>
                      <div className="aipc-cell-id">{c.id}</div>
                      {c.description && <div className="aipc-cell-desc">{c.description}</div>}
                    </td>
                    <td>
                      {provider && model ? (
                        <>
                          <div>{provider.name}</div>
                          <div className="aipc-cell-id">{model.name}</div>
                        </>
                      ) : (
                        <span className="aipc-badge warn"><AlertTriangle size={11} /> Broken reference</span>
                      )}
                    </td>
                    <td>{paramText || <span className="aipc-muted">provider defaults</span>}</td>
                    <td>
                      <div className="aipc-chips small">
                        {(c.capabilities || []).length === 0
                          ? <span className="aipc-muted">—</span>
                          : (c.capabilities || []).map((x) => (
                              <span key={x} className="aipc-chip static">
                                {doc.capabilities.find((y) => y.id === x)?.label || x}
                              </span>
                            ))}
                      </div>
                    </td>
                    <td>
                      {exec.ok
                        ? <span className="aipc-badge ok"><Check size={11} /> Ready</span>
                        : <span className="aipc-badge warn" title={exec.reason}><AlertTriangle size={11} /> Blocked</span>}
                      {!exec.ok && <div className="aipc-test bad">{exec.reason}</div>}
                    </td>
                    <td>
                      <button
                        type="button"
                        className={`aipc-toggle${c.enabled ? ' on' : ''}`}
                        onClick={() => run(() => setConfigurationEnabled(c.id, !c.enabled), c.enabled ? 'Configuration disabled.' : 'Configuration enabled.')}
                        aria-label={c.enabled ? 'Disable configuration' : 'Enable configuration'}
                      >
                        <span />
                      </button>
                    </td>
                    <td className="aipc-col-actions">
                      <button type="button" className="aipc-icon-btn" title="Clone" onClick={() => clone(c)}><Copy size={15} /></button>
                      <button type="button" className="aipc-icon-btn" title="Edit" onClick={() => startEdit(c)}><Pencil size={15} /></button>
                      <button type="button" className="aipc-icon-btn danger" title="Delete" onClick={() => remove(c)}><Trash2 size={15} /></button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}

export default ConfigurationsTab;
