                        );
                      }
                    }
                  })()}
                </div>

                {/* Reaction icons count bar */}
                {cmt.reactions && cmt.reactions.length > 0 && (
                  <div className="ca-reactions-bar">
                    {cmt.reactions.map(r => {
                      const hasReacted = r.users.includes('Briselle');
                      return (
                        <button key={r.emoji} className={`ca-reaction-pill${hasReacted ? ' active' : ''}`} onClick={() => addReaction(cmt.id, r.emoji)}>
                          <span className="ca-rp-emoji">{r.emoji}</span>
                          <span className="ca-rp-count">{r.count}</span>
                        </button>
                      );
                    })}
                  </div>
                )}

                {isSele
        <MentionPopover
                            commentId: cmt.id,
                            position: { x: rect.left - parentRect.left - 180, y: rect.top - parentRect.top - 240 }
                          });
                          setAttachmentPicker(null);
                        }}
                      >
                        <AtSign size={14} />
                      </button>
                      <button 
                        className={`ca-reply-send${replyTexts[cmt.id]?.trim() ? ' active' : ''}`}
                        onClick={() => {
                          if (replyTexts[cmt.id]?.trim()) {
                            addReply(cmt.id, replyTexts[cmt.id], []);
                            setReplyTexts(prev => ({ ...prev, [cmt.id]: '' }));
                          }
                        }}
                        disabled={!replyTexts[cmt.id]?.trim()}
                      >
                        <Send size={10} />
                      </button>

                    </div>
                  </div>
                )}

                {isSelected && (
                  /* Resolve / Unresolve button */
                  <button 
                    className="ca-resolve-btn" 
                    onClick={(e) => {
                      e.stopPropagation();
                      resolveComment(cmt.id);
                    }}
                  >
                    {cmt.resolved ? 'Unresolve' : 'Resolve'}
                  </button>
                )}
              </>
            )}
          </div>
        );
      })}

      {/* Popovers */}
      {attachmentPicker && (
        <AttachmentPopover
          position={attachmentPicker.position}
          onSelect={(fileName) => {
            const cId = attachmentPicker.commentId;
            setReplyTexts(prev => ({ ...prev, [cId]: (prev[cId] || '') + fileName }));
            setTimeout(() => {
              const input = document.querySelector(`[data-card-id="${cId}"] .ca-reply-input`);
              if (input) input.focus();
            }, 50);
          }}
          onClose={() => setAttachmentPicker(null)}
        />
      )}

      {mentionPicker && (
        <MentionPopover
          position={mentionPicker.position}
          onSelect={(mentionVal) => {
            const cId = mentionPicker.commentId;
            setReplyTexts(prev => ({ ...prev, [cId]: (prev[cId] || '') + mentionVal }));
            setTimeout(() => {
              const input = document.querySelector(`[data-card-id="${cId}"] .ca-reply-input`);
              if (input) input.focus();
            }, 50);
          }}
          onClose={() => setMentionPicker(null)}
        />
      )}
    </div>
  );
});

/* ---- Legacy Emoji Picker (kept for callout icons) ---- */
/* ---- Legacy Emoji Picker (kept for callout icons) ---- */
export function EmojiPicker({ onSelect, position, onClose }) {
  const ref = useRef(null);
  const emojis = ['📝','📌','🚀','⭐','❤️','🔥','💡','✅','❌','🎯','📢','🛠','⚡','🌟','💬','🧪','🎨','📚','🔑','🏆','💎','🌈','🎵','📎','📒','🗂','📊','🖼'];
  useEffect(() => {
    const handler = (e) => { if (ref.current && !ref.current.contains(e.target)) onClose(); };
    document.addEventListener('mousedown', handler);
    return () => document.removeEventListener('mousedown', handler);
  }, [onClose]);
  return (
    <div className="emoji-picker-menu" ref={ref} style={{ left: position?.x || 0, top: position?.y || 0 }}>
      <div className="emoji-grid">{emojis.map(em => <span key={em} onClick={() => onSelect(em)}>{em}</span>)}</div>
    </div>
  );
}
// MISSING LINE 1624
