export const NotionPageTextComment = memo(function NotionPageTextComment() {
  const { 
    comments, addReply, resolveComment, updateCommentMsg, deleteCommentMsg, updateBlockContent,
    activeCommentId, setActiveCommentId, saveDraftComment, cancelDraftComment,
    deleteComment, toggleUnreadComment, toggleMuteComment, addReaction,
    hoveredCommentId, setHoveredCommentId
  } = usePageContext();

  const [replyTexts, setReplyTexts] = useState({});
  const [draftText, setDraftText] = useState({});
  const [cardPositions, setCardPositions] = useState({});
  const [activeReactionPopover, setActiveReactionPopover] = useState(null);
  const [activeMorePopover, setActiveMorePopover] = useState(null);
  const [attachmentPicker, setAttachmentPicker] = useState(null);
  const [mentionPicker, setMentionPicker] = useState(null);
  const [toastMessage, setToastMessage] = useState(null);
  const [editingMsg, setEditingMsg] = useState(null); // { commentId, text }

  const containerRef = useRef(null);

  const triggerToast = useCallback((msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 2000);
  }, []);

  // Auto-sweep draft comments when they lose focus
  useEffect(() => {
    comments.forEach(c => {
      if (c.isDraft && c.id !== activeCommentId) {
        handleCancelDraft(c.id);
      }
    });
  }, [activeCommentId, comments]);

                                <span className="ca-avatar">
                                  {lastMsg.author ? lastMsg.author[0] : 'B'}
                                </span>
                                <div className="ca-msg-body">
  );
});

/* ==================================================================
   NOTION PAGE TEXT COMMENT SIDEBAR
   ================================================================== */
export const NotionPageTextComment = memo(function NotionPageTextComment({ visible = true, onHoverChange = () => {} }) {
  const { 
    comments, addReply, resolveComment, updateCommentMsg, deleteCommentMsg, updateBlockContent,
    activeCommentId, setActiveCommentId, saveDraftComment, cancelDraftComment,
    deleteComment, toggleUnreadComment, toggleMuteComment, addReaction,
    hoveredCommentId, setHoveredCommentId
  } = usePageContext();

  const [replyTexts, setReplyTexts] = useState({});
  const [draftText, setDraftText] = useState({});
  const [cardPositions, setCardPositions] = useState({});
  const [activeReactionPopover, setActiveReactionPopover] = useState(null);
  const [activeMorePopover, setActiveMorePopover] = useState(null);
  const [attachmentPicker, setAttachmentPicker] = useState(null);
  const [mentionPicker, setMentionPicker] = useState(null);
  const [toastMessage, setToastMessage] = useState(null);
  const [editingMsg, setEditingMsg] = useState(null); // { commentId, text }

  const containerRef = useRef(null);

  const triggerToast = useCallback((msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(n
          let estHeight = 90;
          if (isDraft) {
            estHeight = 160;
          } else if (isSelected) {
            const msgCount = cmt.thread ? cmt.thread.length : 0;
            estHeight = 90 + msgCount * 65 + 60;
          } else {
            estHeight = cmt.thread && cmt.thread.length > 1 ? 170 : 90;
          }
          heights[cmt.id] = estHeight;
        }
      });

      const positions = {};
      let lastBottom = 0;
      const MIN_GAP = 24; // Generous thread spacing matching Notion

      for (const cmt of comments) {
        let top = targets[cmt.id] ?? 0;
        if (top < lastBottom + MIN_GAP) {
          top = lastBottom + MIN_GAP;
        }
        positions[cmt.id] = top;
        lastBottom = top + (heights[cmt.id] ?? 90);
      }
      setCardPositions(positions);
    };

    const frame = requestAnimationFrame(computePositions);
    window.addEventListener('resize', computePositions);
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener('resize', computePositions);
    };
  }, [comments, activeCommentId, replyTexts, draftText]);

  const handleCancelDraft = useCallback((commentId) => {
    const markEl = document.querySelector(`.inline-comment-highlight[data-comment-id="${commentId}"], .inline-comment[data-comment-id="${commentId}"]`);
    if (markEl) {
      const parent = markEl.parentNode;
      if (parent) {
        while (markEl.firstChild) {
          parent.insertBefore(markEl.firstChild, markEl);
        }
        parent.removeChild(markEl);
        const ce = parent.closest('[contenteditable]') || parent;
        const block = parent.closest('.block');
        const bId = block?.getAttribute('data-block-id');
        if (ce && bId) updateBlockContent(bId, ce.innerHTML);
      }
    }
    cancelDraftComment(commentId);
    if (activeCommentId === commentId) {
      setActiveCommentId(null);
    }
  }, [cancelDraftComment, activeCommentId, setActiveCommentId, updateBlockContent]);

  const handleSaveDraft = useCallback((commentId) => {
    const text = draftText[commentId];
    if (!text?.trim()) return;

    const markEl = document.querySelector(`.inline-comment-highlight[data-comment-id="${commentId}"], .inline-comment[data-comment-id="${commentId}"]`);
    if (markEl) {
      markEl.classList.remove('draft');
      const ce = markEl.closest('[contenteditable]');
  
          </div>
        );
      })}
    </div>
  );
    setDraftText(prev => {
      const next = { ...prev };
      delete next[commentId];
      return next;
    });
  }, [draftText, saveDraftComment, updateBlockContent]);

  if (!comments || comments.length === 0) return null;

  return (
    <div className="comment-annotations" ref={containerRef}>
      {toastMessage && <div className="ca-toast">{toastMessage}</div>}

      {comments.map(cmt => {
        const top = cardPositions[cmt.id] ?? 0;
        const isSelected = cmt.id === activeCommentId;
        const isHovered = hoveredCommentId === cmt.id;
        const isDraft = cmt.isDraft;

        const block = parent.closest('.block');
        const bId = block?.getAttribute('data-block-id');
        if (ce && bId) updateBlockContent(bId, ce.innerHTML);
      }
    }
    cancelDraftComment(commentId);
    if (activeCommentId === commentId) {
      setActiveCommentId(null);
    }
  }, [cancelDraftComment, activeCommentId, setActiveCommentId, updateBlockContent]);

  const handleSaveDraft = useCallback((commentId) => {
    const text = draftText[commentId];
    if (!text?.trim()) return;

    const markEl = document.querySelector(`.inline-comment-highlight[data-comment-id="${commentId}"], .inline-comment[data-comment-id="${commentId}"]`);
    if (markEl) {
      markEl.classList.remove('draft');
      const ce = markEl.closest('[contenteditable]');
      const block = markEl.closest('.block');
      const bId = block?.getAttribute('data-block-id');
      if (ce && bId) updateBlockContent(bId, ce.innerHTML);
    }

    saveDraftComment(commentId, text);
    setDraftText(prev => {
      const next = { ...prev };
      delete next[commentId];
      return next;
    });
  }, [draftText, saveDraftComment, updateBlockContent]);

  if (!comments || comments.length === 0) return null;

  return (
    <div 
      className={`comment-annotations${visible ? '' : ' comments-hidden'}`} 
      ref={containerRef}
      onMouseEnter={() => onHoverChange(true)}
      onMouseLeave={() => onHoverChange(false)}
    >
      {toastMessage && <div className="ca-toast">{toastMessage}</div>}

      {comments.map(cmt => {
        const top = cardPositions[cmt.id] ?? 0;
        const isSelected = cmt.id === activeCommentId;
        const isHovered = hoveredCommentId === cmt.id;
        const isDraft = cmt.isDraft;

        return (
          <div 
            key={cmt.id} 
            data-card-id={cmt.id}
            className={`ca-card${isSelected ? ' active' : ''}${isHovered ? ' hovered' : ''}${cmt.resolved ? ' resolved' : ''}`} 
            style={{ top }}
            onClick={(e) => {
              e.stopPropagation();
              if (activeCommentId !== cmt.id) {
                setActiveCommentId(cmt.id);
              }
            }}
            onMouseEnter={() => setHoveredCommentId(cmt.id)}
            onMouseLeave={() => setHoveredCommentId(null)}
          >
            {/* Hover Actions Bar */}
            {!isDraft && (
              <div className={`ca-card-hover-actions${cmt.muted ? ' has-muted' : ''}${cmt.unread ? ' has-unread' : ''}`}>
                {/* Mute button: visible as first icon if muted OR card hovered/active */}
                {(cmt.muted || isHovered || isSelected) && (
                  <button 
                    className={`ca-hover-btn ca-mute-btn${cmt.muted ? ' is-muted' : ''}`}
            
                    transition: 'background 0.15s'
                  }}
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                    <line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>
                  </svg>
                </button>
              </div>
            </div>
            <button className="comment-resolve" onClick={() => resolveComment(cmt.id)}>Resolve</button>
          </div>
        ))}
      </div>
    </div>
  );
});

