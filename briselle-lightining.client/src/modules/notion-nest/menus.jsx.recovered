// MISSING LINE 1628
          }}
          onClose={() => setAttachmentPicker(null)}
        />
      )}

      {mentionPicker && (
        <MentionPopover
          position={mentionPicker.position}
          onSelect={(mentionVal) => {
            const cId = mentionPicker.commentId;
            setReplyTexts(prev => ({ ...prev, [cId]: (prev[cId] || '') + mentionVal }));
            setTimeout(() => {
              const input = document.querySelector(`[data-card-id="${cId}"] .ca-reply-input`);
              if (input) input.focus();
            }, 50);
          }}
          onClose={() => setMentionPicker(null)}
        />
      )}
    </div>
  );
});

