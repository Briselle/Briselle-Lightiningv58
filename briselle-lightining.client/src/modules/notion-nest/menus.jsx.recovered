                                  <div className="ca-msg-meta">
                                    <span className="ca-author">{lastMsg.author}</span>
                                    <span className="ca-time">{lastMsg.time}</span>
                                  </div>
                                  <div className="ca-msg-text">{renderCommentText(lastMsg.text)}</div>
