// Write updated content to menus.jsx
const emojiStart = content.indexOf('/* ---- Comprehensive Emoji Data ---- */');
const iconsEnd = content.indexOf('/* ---- Selection save/restore helpers ---- */');

if (emojiStart !== -1 && iconsEnd !== -1) {
  const newMiddle = EMOJI_CATEGORIES_STRING + '\\n\\n' + SVG_ICONS_STRING + '\\n\\n';
  const updatedContent = content.substring(0, emojiStart) + newMiddle + content.substring(iconsEnd);
  fs.writeFileSync(filePath, updatedContent, 'utf8');
  console.log('Emojis and icons fixed successfully.');
} else {
  console.error('Could not find markers to update emojis and icons.');
}

